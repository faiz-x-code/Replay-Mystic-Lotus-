{
  "name": "mystic-lotus-replay-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "build:vercel": "npm run install:all && npm run build",
    "start": "node server.js",
    "package:hostinger": "node scripts/package-hostinger.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "serverless-http": "^3.2.0",
    "youtube-transcript": "^1.3.1"
  }
}
